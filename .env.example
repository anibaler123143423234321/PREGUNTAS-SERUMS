# =======================================================
# CODESOFT - CONFIGURACIÓN
# =======================================================
# IMPORTANTE: toda variable con prefijo VITE_ queda incrustada en el JavaScript
# público del sitio. NUNCA pongas claves de IA con prefijo VITE_.

# Supabase Cloud (Obtener en https://supabase.com) — la anon key es pública por diseño;
# la seguridad la dan las políticas RLS de src/data/supabase_schema.sql
VITE_SUPABASE_URL=https://tu_proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_publishable_anon_key_aqui

# Clave PRIVADA de Groq para la función de servidor netlify/functions/ai-generate.mjs
# (configúrala en Netlify > Site configuration > Environment variables).
# Si no la configuras, cada usuario puede pegar su propia clave en "⚙️ Claves".
GROQ_API_KEY=tu_api_key_de_groq_aqui
